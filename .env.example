# Database
BP_POSTGRES_DATABASE_URI=postgresql://postgres:yourpassword@localhost:5432/buspoint_db

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# OpenRouteService (real-road GPS geometry) — free tier at openrouteservice.org
ORS_API_KEY=your-ors-api-key-here

# Stadia Maps (map tiles) — free tier at stadiamaps.com
STADIA_API_KEY=your-stadia-api-key-here

# MTN MoMo (payments) — sandbox account at momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your-momo-subscription-key
MOMO_API_USER=your-momo-api-user
MOMO_API_KEY=your-momo-api-key
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR

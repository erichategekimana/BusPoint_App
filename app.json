{
  "expo": {
    "name": "Bus Point",
    "slug": "bus-point",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buspoint.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.buspoint.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "YOUR_MAPBOX_DOWNLOAD_TOKEN"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bus Point to access your location"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bus Point to access your camera"
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow Bus Point to access your camera for scanning"
        }
      ]
    ],
    "extra": {
      "API_BASE_URL": "http://your-backend-url.com/api",
      "MAPBOX_ACCESS_TOKEN": "your_mapbox_token",
      "SOCKET_URL": "http://your-backend-url.com"
    }
  }
}
